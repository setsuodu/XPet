<Window x:Class="XPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPet"
        Width="220" Height="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>

        <!-- 气泡 -->
        <Border x:Name="Bubble" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="8,8,8,0" Padding="10,6" MaxWidth="200"
                CornerRadius="10" BorderBrush="#33000000" BorderThickness="1"
                Background="#F5FFFFFF" Visibility="Collapsed">
            <TextBlock x:Name="BubbleText" FontSize="13" Foreground="#222222"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="84"/>
        </Border>

        <!-- 宠物（精灵图版） -->
        <Grid x:Name="Pet" Width="160" Height="180"
              VerticalAlignment="Bottom" Margin="0,0,0,10"
              Background="Transparent" Cursor="Hand"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScale"/>
                    <TranslateTransform x:Name="BobShift"/>
                    <TranslateTransform x:Name="JumpShift"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 角色图片 -->
            <Image x:Name="PetImage"
                   Width="160" Height="160"
                   VerticalAlignment="Bottom"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- 入库状态灯：绿=运行中，灰=已停止 -->
            <Ellipse x:Name="Led" Width="12" Height="12"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="18,42,0,0"
                     Fill="#9AA5A0" Stroke="White" StrokeThickness="1.5"/>

            <!-- 待处理数量角标 -->
            <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,28,12,0" MinWidth="24" Height="24"
                    CornerRadius="12" Background="#E5484D" Visibility="Collapsed">
                <TextBlock x:Name="BadgeText" Foreground="White" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
            </Border>
        </Grid>

    </Grid>
</Window>
