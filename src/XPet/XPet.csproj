<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- WPF 和 WinForms（只用来做托盘图标）同时启用时，隐式 using 会造成类型歧义，所以关掉 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XPet</AssemblyName>
    <RootNamespace>XPet</RootNamespace>
    <ApplicationIcon>Resources\xpet.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Pet\**\*.png" />
    <!-- ApplicationIcon 已写入 PE；再复制一份到输出目录，方便开发时托盘加载 -->
    <None Update="Resources\xpet.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 语音文件：复制到输出目录，方便热替换，不嵌入 -->
    <None Update="Resources\Voice\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 工具中心默认配置：复制到输出目录 Panel/ 下 -->
    <None Update="Panel\tools.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
