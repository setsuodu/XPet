<Window x:Class="XPet.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPet 工具中心"
        Height="620" Width="920"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="PanelCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelAccentBrush" Color="#2B6CB0"/>
        <SolidColorBrush x:Key="PanelAccentHoverBrush" Color="#2C5282"/>
        <SolidColorBrush x:Key="PanelTextPrimary" Color="#1A202C"/>
        <SolidColorBrush x:Key="PanelTextSecondary" Color="#718096"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PanelDangerBrush" Color="#E53E3E"/>
        <SolidColorBrush x:Key="PanelSuccessBrush" Color="#38A169"/>

        <Style x:Key="CategoryHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PanelTextPrimary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="180"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelAccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛠️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="XPet 工具中心" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PanelTextPrimary}"/>
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="{StaticResource PanelTextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F7FAFC" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Width="240">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Content="打开配置" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="OpenConfig_Click"/>
                    <Button Content="重新载入" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Reload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容：左侧分类 + 右侧工具卡片 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分类 -->
            <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CategoryList"/>
                </ScrollViewer>
            </Border>

            <!-- 右侧工具区 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ToolHost"/>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock x:Name="FooterText" Text="单击卡片执行 · 配置文件在 %APPDATA%\XPetPanel\tools.json" FontSize="12" Foreground="{StaticResource PanelTextSecondary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource PanelAccentBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
